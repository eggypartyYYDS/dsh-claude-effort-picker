{
  "name": "dsh-claude-effort-picker",
  "version": "0.1.2",
  "description": "Claude 风格的推理等级滑条：蓝色渐变胶囊轨道 + 奶油色大旋钮 + 向右流动的圆点，High→最高档之间渐变染色，⚡ 点亮只加速不换档 / A Claude-style reasoning-effort slab for DeepSeek Harness",
  "license": "SEE LICENSE IN LICENSE",
  "author": "eggypartyYYDS",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "reasoning-effort",
    "claude-style",
    "slider",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eggypartyYYDS/dsh-claude-effort-picker.git"
  },
  "homepage": "https://github.com/eggypartyYYDS/dsh-claude-effort-picker#readme",
  "bugs": {
    "url": "https://github.com/eggypartyYYDS/dsh-claude-effort-picker/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "preview",
    "test"
  ],
  "scripts": {
    "test": "node test/client.test.mjs",
    "preview": "node preview/build-preview.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
